#%RAML 1.0 DataType
#  RestDatatakeGroup:
    type: object
    properties:
      id?:
        type: integer
        format: long
        default: 0
        description: The persistent id of this object
      version?:
        type: integer
        default: 1
        description: A version identifier to track updates to the object (especially to detect concurrent update attempts)
      missionCode:
        type: string
        description: The mission code (e. g. S5P)
      dtGroupIdentifier:
        type: string
        description: (External) identifier for the datatake group
      datatakes:
        type: RestDatatake[]
        description: The datatakes belonging to this group
