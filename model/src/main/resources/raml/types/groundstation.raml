#%RAML 1.0 DataType
#  RestGroundStation:
    type: object
    properties:
      id?:
        type: integer
        format: long
        default: 0
        description: The persistent id of this object
      version?:
        type: integer
        default: 1
        description: A version identifier to track updates to the object (especially to detect concurrent update attempts)
      stationId:
        type: string
        description: Unique, mission-independent ID of the ground station
      stationName:
        type: string
        description: The name of the ground station
